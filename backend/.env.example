# ──────────────────────────────────────────────
# AI Knowledge Assistant — Environment Variables
# Copy this file to .env and fill in the values.
# All variables have safe local-dev defaults;
# you only NEED to set them for production.
# ──────────────────────────────────────────────

# Django
DEBUG=True
DJANGO_SECRET_KEY=          # leave blank to use the built-in dev key
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS (ignored when DEBUG=True — all origins allowed in dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (default: SQLite — no config needed for local)
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Email (defaults to console backend in DEBUG mode)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Security (production only)
SECURE_SSL_REDIRECT=False
